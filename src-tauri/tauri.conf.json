{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QueryVerse",
  "identifier": "queryverse",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "QueryVerse",
        "transparent": false,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "title": "QueryVerse",
        "width": 1400,
        "height": 800,
        "minWidth": 1400,
        "minHeight": 800,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
